{
  "name": "course-site",
  "version": "0.0.0",
  "scripts": {
    "start": "ng serve --host 0.0.0.0 --proxy-config proxy.conf.json",
    "build": "ng build",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "api": "wrangler dev --port 8787",
    "deploy": "ng build && wrangler deploy"
  },
  "private": true,
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "dependencies": {
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/forms": "^22.2.4",
    "@angular/platform-browser": "^22.2.4",
    "@videojs/html": "^10.3.0",
    "@videojs/youtube-video": "^10.3.0",
    "aws4fetch": "^1.0.20",
    "hls.js": "^1.7.4",
    "ngx-extended-pdf-viewer": "^31.0.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.4",
    "prettier": "^3.8.1",
    "typescript": "~6.0.3",
    "wrangler": "^4"
  }
}
